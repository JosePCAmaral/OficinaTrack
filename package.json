{
  "name": "oficinatrack",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm build:shared && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @oficinatrack/shared build",
    "lint": "oxlint",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test"
  },
  "devDependencies": {
    "oxlint": "^1.58.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "mysql2": "^3.22.0"
    }
  }
}
